server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # API pela rede privada do Railway: o backend nao precisa de dominio publico nem de CORS.
  # Resolver + variavel = DNS reavaliado a cada 10s (o IP interno muda a cada deploy do backend).
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
  location /api/ {
    set $backend ${BACKEND_INTERNAL_URL};
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  # SPA: qualquer rota desconhecida cai no index.html (inclui a pagina 404 do React)
  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(js|css|woff2?|png|jpg|jpeg|svg|ico)$ {
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  add_header X-Content-Type-Options nosniff;
  add_header X-Frame-Options SAMEORIGIN;
  add_header X-Powered-By-Domingo "Servido estaticamente, como as nossas opinioes";
}
