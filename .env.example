# URL base da API. No docker compose o browser acessa via localhost mapeado.
VITE_API_URL=http://localhost:3333/api
VITE_STORE_NAME=Roupa de Domingo

# SEO e medicao (opcionais; vazio = desligado). No Railway, como variaveis do servico frontend.
# Google Analytics 4 (G-XXXXXXXXXX): so carrega com consentimento de "Estatisticas"
VITE_GA_MEASUREMENT_ID=
# Meta Pixel (so digitos): so carrega com consentimento de "Marketing"
VITE_META_PIXEL_ID=
# Codigo do <meta name="google-site-verification"> (ou verifique o dominio por TXT no Cloudflare)
VITE_GOOGLE_SITE_VERIFICATION=
# Codigo do <meta name="msvalidate.01"> do Bing Webmaster Tools
VITE_BING_SITE_VERIFICATION=
